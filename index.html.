}

/* =========================================================
   ACCUEIL — PROJETS
   ========================================================= */
function renderProjectsHome() {
  const grid = $('#projects-grid'), empty = $('#empty-projects-state'), nores = $('#no-results-state');
  const q = ($('#project-search').value || '').trim().toLowerCase();
  grid.innerHTML = '';
  $('#home-count').textContent = projects.length ? `${projects.length} événement${projects.length > 1 ? 's' : ''}` : 'Bienvenue';
  if (!projects.length) { grid.classList.add('hide'); nores.classList.add('hide'); empty.classList.remove('hide'); return; }
  empty.classList.add('hide'); grid.classList.remove('hide');

  const list = [...projects]
    .sort((a, b) => (b.updatedAt || +b.id || 0) - (a.updatedAt || +a.id || 0))
    .filter(p => String(p.name).toLowerCase().includes(q));
  nores.classList.toggle('hide', list.length > 0);

  if (!q) {
    const nc = document.createElement('button');
    nc.className = 'project-new'; nc.onclick = () => openProjectModal();
    nc.innerHTML = `<span class="pn-icon"><i class="fa-solid fa-plus"></i></span><span class="pn-title">Nouveau plan</span><span class="pn-sub">Mariage, anniversaire, soirée…</span>`;
    grid.appendChild(nc);
  }

  list.forEach(p => {
    const d = p.data || {}; const gs = d.guests || []; const ts = d.tables || [];
    const placed = gs.filter(g => g.tableId != null).length;
    const pct = gs.length ? Math.round(placed / gs.length * 100) : 0;
    const icon = THEMES[p.icon] ? p.icon : 'fa-champagne-glasses';
    const theme = THEMES[icon];
    const bg = p.thumb || (d.backgroundUrl && d.backgroundUrl !== 'none' ? d.backgroundUrl : null);
    const card = document.createElement('div');
    card.className = 'project-card'; card.tabIndex = 0;
    card.onclick = () => openProject(p.id);
    card.onkeydown = (e) => { if (e.key === 'Enter') openProject(p.id); };
    card.innerHTML = `
      <div class="pc-cover ${bg ? 'has-img' : ''}" ${bg ? `style="background-image:url('${esc(bg)}')"` : ''}>
        <div class="pc-cover-shade"></div>
