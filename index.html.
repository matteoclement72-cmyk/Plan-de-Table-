function openConfigModal(id) {
  if (isGlobalLock) return;
  const t = tables.find(x => x.id === id); if (!t) return;
  const round = isRoundTable(t);
  configState = { tableId: id, round, counts: { top: 0, bottom: 0, left: 0, right: 0 }, total: t.chairList.length };
  if (!round) t.chairList.forEach(c => { configState.counts[chairSide(t, c)]++; });
  $('#config-title').textContent = `Configurer · ${t.name}`;
  $('#config-table-name').value = t.name;
  $('#config-table-width').value = t.widthCm; $('#config-table-height').value = t.heightCm; $('#config-table-diam').value = t.widthCm;
  $('#config-row-wh').classList.toggle('hide', round); $('#config-row-diam').classList.toggle('hide', !round);
  $('#config-seats-rect').classList.toggle('hide', round); $('#config-seats-round').classList.toggle('hide', !round);
  updateConfigUI(); openModal('config-table-modal');
}
function adjustConfigChair(side, delta) {
  if (side === 'total') configState.total = clamp(configState.total + delta, 0, 30);
  else configState.counts[side] = clamp(configState.counts[side] + delta, 0, 20);
  updateConfigUI();
}
function updateConfigUI() {
  SIDES.forEach(s => { $(`#config-count-${s}`).textContent = configState.counts[s]; });
  $('#config-count-total').textContent = configState.total;
  const total = configState.round ? configState.total : SIDES.reduce((a, s) => a + configState.counts[s], 0);
  $('#config-total-label').textContent = `${total} place${total > 1 ? 's' : ''}`;
}
function saveTableConfig() {
  const t = tables.find(x => x.id === configState.tableId); if (!t) return;
  const occIds = new Set(guests.filter(g => g.tableId === t.id).map(g => g.chairId));
  const name = $('#config-table-name').value.trim() || t.name;
  if (configState.round) {
    const occ = t.chairList.filter(c => occIds.has(c.id)).length;
    if (configState.total < occ) { showToast(`Impossible : ${occ} invité(s) sont assis à cette table. Libérez d'abord des places.`, 'error'); return; }
    pushHistory();
    const sorted = [...t.chairList].sort((a, b) => chairAngle(a) - chairAngle(b));
    const d = clamp(parseInt($('#config-table-diam').value, 10) || t.widthCm, 40, 600);
    t.widthCm = t.heightCm = d;
    t.chairList = distributeRound(t, configState.total, pickKeep(sorted, configState.total, occIds));
    t.chairsConfig = splitRound(configState.total);
  } else {
    const bySide = { top: [], bottom: [], left: [], right: [] };
    t.chairList.forEach(c => bySide[chairSide(t, c)].push(c));
    for (const s of SIDES) {
      const occ = bySide[s].filter(c => occIds.has(c.id)).length;
      if (configState.counts[s] < occ) { showToast(`Impossible : ${occ} invité(s) assis côté ${SIDE_LABEL[s]}. Libérez d'abord ces places.`, 'error'); return; }
    }
    pushHistory();
    const keepBySide = {};
    SIDES.forEach(s => {
      const sorted = bySide[s].sort((a, b) => (s === 'top' || s === 'bottom') ? a.x - b.x : a.y - b.y);
      keepBySide[s] = pickKeep(sorted, configState.counts[s], occIds);
    });
    t.widthCm = clamp(parseInt($('#config-table-width').value, 10) || t.widthCm, 50, 2000);
    t.heightCm = clamp(parseInt($('#config-table-height').value, 10) || t.heightCm, 40, 2000);
    t.chairList = distributeRect(t, configState.counts, keepBySide);
    t.chairsConfig = { ...configState.counts };
  }
  t.name = name; t.chairsGenerated = true;
  closeModal('config-table-modal'); persist(); renderAll(); showToast('Table mise à jour');
}

