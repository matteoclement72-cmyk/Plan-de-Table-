function openProject(id) {
  const p = projects.find(x => x.id === id); if (!p) return;
  currentProjectId = id;
  guests = clone(p.data.guests || []); tables = clone(p.data.tables || []); roomElements = clone(p.data.roomElements || []);
  tables.forEach(t => {
    if (!t.type || !TABLE_TYPES[t.type]) t.type = 'table_rectangulaire';
    if (!t.chairsConfig) t.chairsConfig = { ...TABLE_TYPES[t.type].chairs };
    if (!Array.isArray(t.chairList)) { t.chairList = []; t.chairsGenerated = false; }
    generateTableChairsIfNeeded(t);
  });
  sanitizeGuests();
  showNames = !!p.data.showNames; isGlobalLock = false; selection = null;
  undoStack = []; redoStack = [];
  hoverPick = null; dropPick = null; flashChair = null; E3.hoverKey = null; E3.dropKey = null;
  flatVB = null;
  $('#editor-project-title').textContent = p.name;
  $('#editor-project-title').title = p.name;
  const theme = THEMES[p.icon];
  $('#editor-theme-label').textContent = (theme ? theme.label : 'Événement') + (p.eventDate ? ' · ' + formatDate(p.eventDate) : '');
  $('#search-guest').value = ''; currentCategoryFilter = 'all';
  $('#home-view').classList.add('hide'); $('#editor-view').classList.remove('hide');
  updateLockUI(); updateNamesUI(); markSaved();
  const ok = init3D();
  if (ok) { resize3D(); Object.assign(E3.cam, { theta: DEFAULT_THETA, phi: DEFAULT_PHI, anim: null }); }
  applyBackground(p);
  renderAll();
  if (ok) fitView(false);
}
function sanitizeGuests() {
  const used = new Set();
  guests.forEach(g => {
    if (g.tableId == null) { g.chairId = null; return; }
    const t = tables.find(x => x.id === g.tableId);
    const key = g.tableId + '|' + g.chairId;
    if (!t || !t.chairList.some(c => c.id === g.chairId) || used.has(key)) { g.tableId = null; g.chairId = null; }
    else used.add(key);
  });
}
function closeProject() {
  captureThumb(); setHover(null);
  saveCurrentProjectData(); currentProjectId = null; selection = null;
  toggleSidebar(false);
  $('#editor-view').classList.add('hide'); $('#home-view').classList.remove('hide');
  renderProjectsHome();
}
function applyBackground(p) {
  const url = p.data.backgroundUrl && p.data.backgroundUrl !== 'none' ? p.data.backgroundUrl : null;
  const op = p.data.bgOpacity !== undefined ? p.data.bgOpacity : 50;
  $('#bg-opacity-slider').value = op; $('#opacity-value').textContent = op + '%';
  $('#opacity-control-container').classList.toggle('hide', !url);
  E3.bgUrl = url;
  if (E3.bgTex) { E3.bgTex.dispose(); E3.bgTex = null; }
  if (!E3.ready) return;
  E3.bgPlane.material.map = null; E3.bgPlane.material.opacity = op / 100; E3.bgPlane.material.needsUpdate = true;
  updateBgPlane();
  if (!url) return;
  loadSafeTexture(url, (tex, aspect) => {
    if (E3.bgUrl !== url) { if (tex) tex.dispose(); return; }
    if (!tex) {
      if (!bgWarned) { bgWarned = true; console.warn("L'image de fond ne peut pas s'afficher depuis un fichier ouvert en local."); }
      return;
    }
    E3.bgTex = tex; E3.bgAspect = aspect || 1;
    E3.bgPlane.material.map = tex; E3.bgPlane.material.needsUpdate = true;
    updateBgPlane(); requestRender();
  });
}
