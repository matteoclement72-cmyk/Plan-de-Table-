  const seated = t.chairList.map((c, i) => ({ g: guests.find(x => x.tableId === t.id && x.chairId === c.id), n: i + 1 })).filter(x => x.g);
  return `<div style="background:#FCFBF9;border:1px solid #E7E1D7;border-radius:14px;padding:20px 22px">
    <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #E7E1D7;padding-bottom:10px;margin-bottom:8px">
      <span style="font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:700;color:#1B2333">${esc(t.name)}</span>
      <span style="font-size:13px;font-weight:600;color:#97763F;background:#F8F2E8;padding:4px 12px;border-radius:20px">${seated.length} / ${t.chairList.length}</span>
    </div>
    ${seated.length ? seated.map(({ g, n }) => `<div style="display:flex;align-items:center;gap:12px;padding:7px 0;font-size:16px;border-bottom:1px dashed #ECE6DC">
      <span style="width:9px;height:9px;border-radius:50%;background:${CAT_COLORS[g.category] || '#999'};flex-shrink:0"></span>
      <span style="flex:1">${esc(g.name)}</span><span style="font-size:12px;color:#A39E95">place ${n}</span></div>`).join('')
      : '<div style="color:#A39E95;font-style:italic;font-size:15px;padding:6px 0">Table vide</div>'}
  </div>`;
}

async function saveToComputer() {
  saveCurrentProjectData(); closeModal('save-modal');
  if (!window.html2canvas || !window.jspdf) { showToast("Le module PDF n'a pas pu être chargé. Vérifiez votre connexion internet.", 'error'); return; }
  if (!E3.ready) { showToast("L'affichage 3D est indisponible : impossible de créer le plan en PDF.", 'error'); return; }
  showToast('Création du PDF en cours…', 'info', null, 20000);
  await wait(60);

  let wrapper = null;
  try {
    // 1. Rendu des deux vues du plan (perspective 3D + vue de dessus)
    let img3d, imgTop;
    try { img3d = capture3D('persp', 1590, 1965); imgTop = capture3D('top', 1590, 1860); }
    catch (err) { console.error(err); img3d = imgTop = pdfFallbackCanvas().toDataURL('image/jpeg', 0.92); }

    const p = getCurrentProject();
    const title = p && p.name ? p.name : 'Mon plan de table';
    const themeLabel = p && THEMES[p.icon] ? THEMES[p.icon].label : 'Événement';
    const placedCount = guests.filter(g => g.tableId != null).length;

    wrapper = document.createElement('div');
    Object.assign(wrapper.style, { position: 'fixed', top: '0', left: '0', width: '1200px', zIndex: '-9999', pointerEvents: 'none' });
    document.body.appendChild(wrapper);

    const stat = (v, l) => `<div><div style="font-family:'Cormorant Garamond',serif;font-size:40px;font-weight:700;color:#1B2333;line-height:1">${v}</div><div style="font-size:12px;color:#6F6B64;letter-spacing:.1em;text-transform:uppercase;margin-top:6px">${l}</div></div>`;
    const pages = [];

    // Page 1 : titre + vue 3D
    const page1 = pdfPage();
    page1.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1px solid #E7E1D7;padding-bottom:26px;margin-bottom:30px">
        <div>
          <div style="font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:#97763F;font-weight:600;margin-bottom:12px">Plan de table · ${esc(themeLabel)}</div>
          <div style="font-family:'Cormorant Garamond',serif;font-size:58px;font-weight:700;color:#1B2333;line-height:1">${esc(title)}</div>
          ${p && p.eventDate ? `<div style="font-size:16px;color:#6F6B64;margin-top:12px">${esc(formatDate(p.eventDate))}</div>` : ''}
        </div>
        <div style="display:flex;gap:34px;text-align:right">${stat(guests.length, 'Invités')}${stat(tables.length, 'Tables')}${stat(placedCount, 'Placés')}</div>
      </div>
      <div style="height:1310px;border:1px solid #E7E1D7;border-radius:18px;overflow:hidden;background:#EDE8E0;display:flex;align-items:center;justify-content:center">
        <img src="${img3d}" style="width:100%;height:100%;object-fit:cover;display:block">
      </div>`;
    pages.push(page1);

    // Page 2 : vue de dessus + légende
    const legend = ['homme', 'femme', 'enfant'].map(k => `<span style="display:inline-flex;align-items:center;gap:10px"><span style="width:14px;height:14px;border-radius:50%;background:${CAT_COLORS[k]}"></span>${CATEGORIES[k].label}</span>`).join('')
      + '<span style="display:inline-flex;align-items:center;gap:10px"><span style="width:14px;height:14px;border-radius:50%;background:#F1ECE2;border:1px solid #CFC6B6"></span>Place libre</span>';
    const page2 = pdfPage();
    page2.innerHTML = `
      <div style="font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:#97763F;font-weight:600">Vue de dessus</div>
      <div style="font-family:'Cormorant Garamond',serif;font-size:44px;font-weight:700;color:#1B2333;margin:8px 0 26px">Disposition de la salle</div>
      <div style="height:1240px;border:1px solid #E7E1D7;border-radius:18px;overflow:hidden;background:#EDE8E0;display:flex;align-items:center;justify-content:center">
        <img src="${imgTop}" style="width:100%;height:100%;object-fit:cover;display:block">
      </div>
      <div style="display:flex;gap:30px;justify-content:center;margin-top:22px;font-size:16px;color:#46546E;font-weight:600">${legend}</div>`;
    pages.push(page2);

    // Pages suivantes : listes par table en deux colonnes
    const cards = sortedTables().map(pdfTableCard);
    const unplaced = guests.filter(g => g.tableId == null);
    if (unplaced.length) cards.push(`<div style="background:#F8F2E8;border:1px solid #EFE3CD;border-radius:14px;padding:20px 22px">
      <div style="font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:700;color:#1B2333;margin-bottom:8px">Invités non placés (${unplaced.length})</div>
      <div style="font-size:15px;color:#46546E;line-height:1.7">${unplaced.map(g => esc(g.name)).join(' · ')}</div></div>`);

    if (cards.length) {
      const COL_W = 515, GAP = 30, PAD = 70, FOOT = 50, H = 1697;
      let col1, col2, h1, h2, maxH;
      const newListPage = (first) => {
        const page = pdfPage(); let top = PAD;
        if (first) {
          page.innerHTML = `<div style="font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:#97763F;font-weight:600">Placement</div><div style="font-family:'Cormorant Garamond',serif;font-size:44px;font-weight:700;color:#1B2333;margin-top:8px">Liste des invités par table</div>`;
          top = 190;
        }
        const mk = (left) => { const c = document.createElement('div'); Object.assign(c.style, { position: 'absolute', width: COL_W + 'px', left: left + 'px', top: top + 'px' }); page.appendChild(c); return c; };
        col1 = mk(PAD); col2 = mk(PAD + COL_W + GAP);
        maxH = H - top - PAD - FOOT; h1 = 0; h2 = 0;
        pages.push(page);
      };
      newListPage(true);
      for (const html of cards) {
        const card = document.createElement('div'); card.style.width = COL_W + 'px'; card.innerHTML = html;
        wrapper.appendChild(card); const ch = card.offsetHeight + 22; wrapper.removeChild(card);
        card.style.marginBottom = '22px';
        if (h1 + ch > maxH && h2 + ch > maxH && (h1 > 0 || h2 > 0)) newListPage(false);
        if (h1 <= h2) { col1.appendChild(card); h1 += ch; } else { col2.appendChild(card); h2 += ch; }
      }
    }

    pages.forEach((pg, i) => {
      const f = document.createElement('div');
      Object.assign(f.style, { position: 'absolute', left: '70px', right: '70px', bottom: '36px', display: 'flex', justifyContent: 'space-between', fontSize: '13px', color: '#A39E95', borderTop: '1px solid #EFEAE2', paddingTop: '12px' });
      f.innerHTML = `<span>${esc(title)}</span><span>Page ${i + 1} / ${pages.length}</span>`;
      pg.appendChild(f);
    });

    // Génération du PDF
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const pw = pdf.internal.pageSize.getWidth(), ph = pdf.internal.pageSize.getHeight();
    for (let i = 0; i < pages.length; i++) {
      if (i > 0) pdf.addPage();
      wrapper.appendChild(pages[i]); await wait(80);
      try {
        const pc = await html2canvas(pages[i], { scale: 1.5, useCORS: true, backgroundColor: '#ffffff' });
        pdf.addImage(pc.toDataURL('image/jpeg', 0.92), 'JPEG', 0, 0, pw, ph);
      } catch (pageErr) { console.error('Erreur de capture de la page', i, pageErr); }
      wrapper.removeChild(pages[i]);
    }
    pdf.save(`plan_de_table_${slug(title)}.pdf`);
    showToast('PDF téléchargé avec succès');
  } catch (error) {
    console.error('Erreur PDF :', error);
    showToast("La création du PDF a échoué. Réessayez ou utilisez « Imprimer » depuis le résumé.", 'error');
  } finally {
    if (wrapper && wrapper.parentNode) wrapper.parentNode.removeChild(wrapper);
  }
}

/* =========================================================
   MODALES, CONFIRMATION, NOTIFICATIONS
   ========================================================= */
function openModal(id) {
  const m = document.getElementById(id); if (!m) return;
  m.classList.add('is-open');
  const i = modalStack.indexOf(id); if (i > -1) modalStack.splice(i, 1);
  modalStack.push(id);
  requestAnimationFrame(() => {
    const f = [...m.querySelectorAll('[data-autofocus]')].find(el => el.offsetParent !== null);
    if (f) { f.focus(); if (f.tagName === 'INPUT' && f.type === 'text' && f.value) f.select(); }
  });
}
function closeModal(id) {
  const m = document.getElementById(id); if (!m) return;
  m.classList.remove('is-open');
  const i = modalStack.indexOf(id); if (i > -1) modalStack.splice(i, 1);
  if (id === 'confirm-modal' && confirmResolver) { const r = confirmResolver; confirmResolver = null; r(false); }
}
function confirmDialog({ title, message, confirmLabel = 'Confirmer', danger = true }) {
  $('#confirm-title').textContent = title; $('#confirm-message').textContent = message;
  const ok = $('#confirm-ok'); ok.textContent = confirmLabel; ok.className = 'btn ' + (danger ? 'btn-danger' : 'btn-primary');
  $('#confirm-icon').className = 'confirm-icon' + (danger ? '' : ' neutral');
  $('#confirm-icon').innerHTML = danger ? '<i class="fa-solid fa-triangle-exclamation"></i>' : '<i class="fa-solid fa-wand-magic-sparkles"></i>';
  if (confirmResolver) { const r = confirmResolver; confirmResolver = null; r(false); }
  openModal('confirm-modal');
  return new Promise(resolve => { confirmResolver = resolve; });
}
function resolveConfirm(value) { const r = confirmResolver; confirmResolver = null; closeModal('confirm-modal'); if (r) r(value); }

function showToast(msg, type = 'success', action = null, duration) {
  const t = $('#toast');
  const icons = { success: 'fa-circle-check', error: 'fa-circle-exclamation', info: 'fa-circle-info' };
  t.className = `toast toast-${type}`;
  t.innerHTML = `<i class="fa-solid ${icons[type] || icons.info}"></i><span>${esc(msg)}</span>${action ? `<button class="toast-action">${esc(action.label)}</button>` : ''}`;
  if (action) t.querySelector('.toast-action').onclick = () => { hideToast(); action.fn(); };
  void t.offsetWidth; t.classList.add('is-visible');
  clearTimeout(toastTimer); toastTimer = setTimeout(hideToast, duration || (action ? 5500 : 3000));
}
function hideToast() { $('#toast').classList.remove('is-visible'); }

/* =========================================================
   CLAVIER
   ========================================================= */
document.addEventListener('keydown', (e) => {
  if (modalStack.length) {
    if (e.key === 'Escape') { e.preventDefault(); closeModal(modalStack[modalStack.length - 1]); }
    return;
  }
  if (!currentProjectId) return;
  const tag = document.activeElement ? document.activeElement.tagName : '';
  const typing = /INPUT|TEXTAREA|SELECT/.test(tag);
  const mod = e.ctrlKey || e.metaKey; const k = e.key.toLowerCase();
  if (typing) { if (e.key === 'Escape') document.activeElement.blur(); return; }
  if (mod && k === 'z' && !e.shiftKey) { e.preventDefault(); undo(); return; }
  if (mod && (k === 'y' || (k === 'z' && e.shiftKey))) { e.preventDefault(); redo(); return; }
  if (mod && k === 'd') { e.preventDefault(); duplicateSelection(); return; }
  if (mod) return;
  if (e.key === 'Escape') { if (document.body.classList.contains('sidebar-open')) toggleSidebar(false); else { setSelection(null); setHover(null); } return; }
  if ((e.key === 'Delete' || e.key === 'Backspace') && selection) { e.preventDefault(); deleteSelection(); return; }
  if (e.key.startsWith('Arrow') && selection) {
    e.preventDefault(); const s = e.shiftKey ? 20 : 4;
    nudge(e.key === 'ArrowLeft' ? -s : e.key === 'ArrowRight' ? s : 0, e.key === 'ArrowUp' ? -s : e.key === 'ArrowDown' ? s : 0);
    return;
  }
  if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { e.preventDefault(); orbitBy(e.key === 'ArrowLeft' ? -1 : 1); return; }
  if (k === 'q' || k === 'e') { orbitBy(k === 'q' ? -1 : 1); return; }
  if (k === 't') { toggleTopView(); return; }
  if (k === 'r' && selection) { rotateSelection(e.shiftKey ? -90 : 90); return; }
  if (e.key === '+' || e.key === '=') { zoomBy(1.25); return; }
  if (e.key === '-' || e.key === '_') { zoomBy(1 / 1.25); return; }
  if (e.key === '0') { fitView(); return; }
  if (e.key === '?') { openModal('shortcuts-modal'); }

});
</script>
