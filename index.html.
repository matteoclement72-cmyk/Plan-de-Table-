/* =========================================================
   HISTORIQUE (ANNULER / RÉTABLIR)
   ========================================================= */
function serialize() { return JSON.stringify({ guests, tables, roomElements }); }
function restoreState(s) { const st = JSON.parse(s); guests = st.guests; tables = st.tables; roomElements = st.roomElements; }
function pushHistory(snapshot) {
  undoStack.push(snapshot || serialize());
  if (undoStack.length > 60) undoStack.shift();
  redoStack = []; updateUndoUI();
}
function undo() {
  if (!undoStack.length) return;
  redoStack.push(serialize()); restoreState(undoStack.pop());
  persist(); renderAll(); showToast('Action annulée', 'info');
}
function redo() {
  if (!redoStack.length) return;
  undoStack.push(serialize()); restoreState(redoStack.pop());
  persist(); renderAll(); showToast('Action rétablie', 'info');
}
function updateUndoUI() { $('#btn-undo').disabled = !undoStack.length; $('#btn-redo').disabled = !redoStack.length; }

