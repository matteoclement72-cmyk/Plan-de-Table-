async function confirmGeneratePlan() {
  const type = $('#gen-plan-type').value; const def = TABLE_TYPES[type] || TABLE_TYPES.table_rectangulaire;
  let w = clamp(parseInt($('#gen-plan-width').value, 10) || def.defaultW, 40, 2000);
  let h = clamp(parseInt($('#gen-plan-height').value, 10) || def.defaultH, 40, 2000);
  if (def.isRound) h = w;
  const shape = pendingPlanType;
  closeModal('generate-plan-modal');
  if (tables.length) {
    const ok = await confirmDialog({ title: 'Remplacer les tables ?', message: 'Les tables actuelles seront remplacées et tous les invités retirés de leurs places. Les autres éléments sont conservés.', confirmLabel: 'Générer le plan', danger: false });
    if (!ok) return;
  }
  if (shape === 'plan_u') createUShapePlan(type, w, h); else createIIShapePlan(type, w, h);
}
function makePlanTable(id, groupId, type, name, x, y, w, h, rotation, chairs) {
  const t = { id, groupId, type, name, x, y, widthCm: w, heightCm: h, rotation, chairsConfig: { ...chairs }, chairList: [], chairsGenerated: false };
  generateTableChairsIfNeeded(t); return t;
}
function createUShapePlan(type = 'table_rectangulaire', w = 204, h = 73) {
  pushHistory(); guests.forEach(g => { g.tableId = null; g.chairId = null; });
  const pxW = w * SCALE_CM_TO_PX, pxH = h * SCALE_CM_TO_PX; const startX = 250, startY = 150;
  const rot = (pxW - pxH) / 2; const gid = 'u_shape_group_' + Date.now();
  const def = TABLE_TYPES[type] || TABLE_TYPES.table_rectangulaire;
  tables = [];
  if (def.isRound) {
    const step = pxW + 2 * (CHAIR_OFFSET + CHAIR_SIZE / 2) + 60; const ch = def.chairs;
    for (let i = 0; i < 3; i++) tables.push(makePlanTable(tables.length + 1, gid, type, `Haut ${i + 1}`, startX + i * step, startY, w, h, 0, ch));
    for (let i = 0; i < 2; i++) tables.push(makePlanTable(tables.length + 1, gid, type, `Gauche ${i + 1}`, startX, startY + (i + 1) * step, w, h, 0, ch));
    for (let i = 0; i < 2; i++) tables.push(makePlanTable(tables.length + 1, gid, type, `Droite ${i + 1}`, startX + 2 * step, startY + (i + 1) * step, w, h, 0, ch));
  } else {
    const ch = { top: 3, bottom: 3, left: 0, right: 0 };
    const rightLeft = startX + 2 * pxW - pxH;
    tables.push(makePlanTable(1, gid, type, 'Table 1', startX, startY, w, h, 0, ch));
    tables.push(makePlanTable(2, gid, type, 'Table 2', startX + pxW, startY, w, h, 0, ch));
    tables.push(makePlanTable(3, gid, type, 'Table 3', rightLeft - rot, startY + pxH + rot, w, h, 90, ch));
    tables.push(makePlanTable(4, gid, type, 'Table 4', rightLeft - rot, startY + pxH + pxW + rot, w, h, 90, ch));
    tables.push(makePlanTable(5, gid, type, 'Table 5', startX - rot, startY + pxH + rot, w, h, 90, ch));
    tables.push(makePlanTable(6, gid, type, 'Table 6', startX - rot, startY + pxH + pxW + rot, w, h, 90, ch));
    // Retire les chaises intérieures des tables du haut qui tomberaient sur les branches du U
    const legs = [[startX, startX + pxH], [rightLeft, rightLeft + pxH]];
    tables.slice(0, 2).forEach(t => {
      const cx = t.x + tablePx(t).w / 2;
      t.chairList = t.chairList.filter(c => c.side !== 'bottom' || !legs.some(([a, b]) => cx + c.x > a - CHAIR_SIZE / 2 && cx + c.x < b + CHAIR_SIZE / 2));
      t.chairsConfig.bottom = t.chairList.filter(c => c.side === 'bottom').length;
    });
  }
  selection = null; persist(); renderAll(); fitView(); showToast('Plan en U généré');
}
function createIIShapePlan(type = 'table_rectangulaire', w = 204, h = 73) {
  pushHistory(); guests.forEach(g => { g.tableId = null; g.chairId = null; });
  const pxW = w * SCALE_CM_TO_PX, pxH = h * SCALE_CM_TO_PX; const startX = 250, startY = 100;
  const rot = (pxW - pxH) / 2; const gid = 'ii_shape_group_' + Date.now();
  const def = TABLE_TYPES[type] || TABLE_TYPES.table_rectangulaire;
  tables = [];
  if (def.isRound) {
    const step = pxW + 2 * (CHAIR_OFFSET + CHAIR_SIZE / 2) + 60; const gapX = Math.max(350, step * 1.8); const ch = def.chairs;
    for (let i = 0; i < 3; i++) tables.push(makePlanTable(tables.length + 1, gid, type, `Gauche ${i + 1}`, startX, startY + i * step, w, h, 0, ch));
    for (let i = 0; i < 3; i++) tables.push(makePlanTable(tables.length + 1, gid, type, `Droite ${i + 1}`, startX + gapX, startY + i * step, w, h, 0, ch));
  } else {
    const ch = { top: 3, bottom: 3, left: 0, right: 0 }; const gapX = 350;
    tables.push(makePlanTable(1, gid, type, 'Table 1', startX - rot, startY + rot, w, h, 90, ch));
    tables.push(makePlanTable(5, gid, type, 'Table 5', startX - rot, startY + pxW + rot, w, h, 90, ch));
    tables.push(makePlanTable(6, gid, type, 'Table 6', startX - rot, startY + 2 * pxW + rot, w, h, 90, ch));
    tables.push(makePlanTable(2, gid, type, 'Table 2', startX + gapX - rot, startY + rot, w, h, 90, ch));
    tables.push(makePlanTable(3, gid, type, 'Table 3', startX + gapX - rot, startY + pxW + rot, w, h, 90, ch));
    tables.push(makePlanTable(4, gid, type, 'Table 4', startX + gapX - rot, startY + 2 * pxW + rot, w, h, 90, ch));
  }
  selection = null; persist(); renderAll(); fitView(); showToast('Plan en II généré');
}

