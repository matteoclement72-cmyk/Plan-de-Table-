function triggerImport() { $('#import-input').click(); }
function handleImport(e) {
  const file = e.target.files[0]; e.target.value = ''; if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const data = JSON.parse(reader.result);
      let list = data && data.project ? [data.project] : Array.isArray(data) ? data : (data && data.projects) || [];
      list = list.filter(p => p && p.name && p.data);
      if (!list.length) throw new Error('vide');
      list.forEach((p, i) => { p.id = (Date.now() + i).toString(); p.updatedAt = Date.now() + i; projects.push(p); });
      saveProjectsToStorage(); renderProjectsHome();
      showToast(`${list.length} projet${list.length > 1 ? 's' : ''} importé${list.length > 1 ? 's' : ''}`);
    } catch (err) { showToast("Ce fichier n'est pas une sauvegarde valide", 'error'); }
  };
  reader.readAsText(file);
}

