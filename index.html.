<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Mes Plans de Table 3D — Créateur de plan de table</title>
<meta name="description" content="Concevez votre salle en 3D, placez vos invités et imprimez vos plans de table pour mariages, anniversaires et soirées.">
<meta name="theme-color" content="#1B2333">

<!-- Bibliothèques pour générer le PDF -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<!-- Moteur 3D -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
/* =========================================================
   PALETTE & VARIABLES
   ========================================================= */
:root{
  --ink:#1B2333; --ink-2:#2C3A52; --ink-3:#46546E;
  --gold:#B08D57; --gold-600:#97763F; --gold-50:#F8F2E8; --gold-100:#EFE3CD;
  --ivory:#F7F5F1; --canvas:#EEEAE3; --surface:#FFFFFF;
  --line:#E7E1D7; --line-2:#D8D0C2;
  --text:#1F2430; --muted:#6F6B64; --faint:#A39E95;
  --homme:#3E5C8A; --homme-bg:#E4EBF5;
  --femme:#A94F73; --femme-bg:#F7E6ED;
  --enfant:#A97A22; --enfant-bg:#F6ECD6;
  --success:#3E7B5A; --success-bg:#E5F1EA;
  --danger:#B4483E; --danger-bg:#F8E6E3;
  --shadow-sm:0 1px 2px rgba(27,35,51,.06),0 1px 3px rgba(27,35,51,.05);
  --shadow-md:0 4px 14px rgba(27,35,51,.08);
  --shadow-lg:0 18px 44px rgba(27,35,51,.14);
  --shadow-xl:0 30px 80px rgba(18,24,36,.28);
  --serif:'Cormorant Garamond',Georgia,'Times New Roman',serif;
}

/* =========================================================
   RESET & UTILITAIRES
   ========================================================= */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
*{-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:'Inter',system-ui,-apple-system,sans-serif;background:var(--ivory);color:var(--text);overflow:hidden;-webkit-font-smoothing:antialiased;font-size:14px;line-height:1.45}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
input,textarea,select{font:inherit;color:inherit}
ul{list-style:none}
img{max-width:100%}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:#D8D0C2;border-radius:10px;border:2px solid transparent;background-clip:padding-box}
::-webkit-scrollbar-thumb:hover{background:#BDB4A4;background-clip:padding-box}

.hide{display:none!important}
.row{display:flex;align-items:center}
.between{justify-content:space-between}
.gap-1{gap:4px}.gap-2{gap:8px}.gap-3{gap:12px}.gap-4{gap:16px}
.grow{flex:1}.min-w-0{min-width:0}.w-full{width:100%}
.stack-3{display:flex;flex-direction:column;gap:12px}
.stack-4{display:flex;flex-direction:column;gap:16px}
.stack-5{display:flex;flex-direction:column;gap:20px}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.view{height:100%}

/* =========================================================
   BOUTONS & CHAMPS
   ========================================================= */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border-radius:10px;font-size:13.5px;font-weight:600;border:1px solid transparent;transition:background .15s,border-color .15s,color .15s,box-shadow .15s,transform .1s;white-space:nowrap}
.btn:active{transform:translateY(1px)}
.btn-primary{background:var(--ink);color:#fff;box-shadow:0 1px 2px rgba(27,35,51,.25)}
.btn-primary:hover{background:var(--ink-2)}
.btn-gold{background:var(--gold);color:#fff}
.btn-gold:hover{background:var(--gold-600)}
.btn-outline{background:#fff;border-color:var(--line-2);color:var(--ink)}
.btn-outline:hover{border-color:var(--ink-3);background:#FCFBF9}
.btn-ghost{color:var(--ink-3)}
.btn-ghost:hover{background:rgba(27,35,51,.05);color:var(--ink)}
.btn-danger{background:var(--danger);color:#fff}
.btn-danger:hover{background:#9C3C33}
.btn-danger-soft{background:var(--danger-bg);color:var(--danger)}
.btn-danger-soft:hover{background:#F3D6D1}
.btn-sm{height:32px;padding:0 12px;font-size:12.5px;border-radius:8px}
.btn-icon{width:38px;height:38px;display:inline-flex;align-items:center;justify-content:center;border-radius:10px;color:var(--ink-3);border:1px solid var(--line);background:#fff;transition:.15s;flex-shrink:0}
.btn-icon:hover{color:var(--ink);border-color:var(--line-2);background:#FCFBF9}
.btn-icon:disabled{opacity:.35;cursor:not-allowed}
.btn-group{display:inline-flex;border:1px solid var(--line);border-radius:10px;background:#fff;overflow:hidden}
.btn-group .btn-icon{border:0;border-radius:0;height:36px}
.btn-group .btn-icon+.btn-icon{border-left:1px solid var(--line)}

.label{display:block;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.label-opt{text-transform:none;letter-spacing:0;font-weight:500;color:var(--faint)}
.help{font-size:12px;color:var(--faint);margin-top:8px}
.input{width:100%;height:42px;padding:0 14px;background:#fff;border:1px solid var(--line-2);border-radius:10px;font-size:14px;color:var(--text);transition:border-color .15s,box-shadow .15s}
.input:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(176,141,87,.18)}
.input::placeholder{color:var(--faint)}
textarea.input{height:auto;padding:12px 14px;line-height:1.55;resize:vertical;min-height:160px}
.input-sm{height:36px;font-size:13px}
.input-icon{position:relative}
.input-icon>i{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--faint);font-size:13px;pointer-events:none}
.input-icon .input{padding-left:36px}

.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.seg-btn{height:36px;border-radius:9px;border:1px solid var(--line);background:#fff;font-size:12.5px;font-weight:600;color:var(--muted);display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:.15s}
.seg-btn:hover{border-color:var(--line-2);color:var(--ink)}
.seg-btn .dot{width:8px;height:8px;border-radius:50%}
.seg-btn[data-cat=homme] .dot{background:var(--homme)}
.seg-btn[data-cat=femme] .dot{background:var(--femme)}
.seg-btn[data-cat=enfant] .dot{background:var(--enfant)}
.seg-btn.is-active[data-cat=homme]{background:var(--homme-bg);border-color:var(--homme);color:var(--homme)}
.seg-btn.is-active[data-cat=femme]{background:var(--femme-bg);border-color:var(--femme);color:var(--femme)}
.seg-btn.is-active[data-cat=enfant]{background:var(--enfant-bg);border-color:var(--enfant);color:var(--enfant)}

.pill-row{display:flex;gap:6px;flex-wrap:wrap}
.pill{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 10px;border-radius:999px;border:1px solid var(--line);background:#fff;font-size:12px;font-weight:600;color:var(--muted);transition:.15s}
.pill:hover{border-color:var(--line-2);color:var(--ink)}
.pill .dot{width:7px;height:7px;border-radius:50%}
.pill-homme .dot{background:var(--homme)}.pill-femme .dot{background:var(--femme)}.pill-enfant .dot{background:var(--enfant)}
.pill-count{font-size:11px;color:var(--faint)}
.pill.is-active{background:var(--ink);border-color:var(--ink);color:#fff}
.pill.is-active .pill-count{color:rgba(255,255,255,.6)}
.pill.is-active .dot{box-shadow:0 0 0 2px rgba(255,255,255,.7)}

.avatar{width:34px;height:34px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:11.5px;font-weight:700;flex-shrink:0;letter-spacing:.02em;background:#EEE9E1;color:var(--ink-3)}
.avatar.cat-homme{background:var(--homme-bg);color:var(--homme)}
.avatar.cat-femme{background:var(--femme-bg);color:var(--femme)}
.avatar.cat-enfant{background:var(--enfant-bg);color:var(--enfant)}
.dot.cat-homme{background:var(--homme)}.dot.cat-femme{background:var(--femme)}.dot.cat-enfant{background:var(--enfant)}

input[type=range]{-webkit-appearance:none;appearance:none;background:transparent;width:84px}
input[type=range]::-webkit-slider-runnable-track{height:4px;background:var(--line-2);border-radius:2px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;height:14px;width:14px;border-radius:50%;background:var(--gold);margin-top:-5px;box-shadow:0 1px 3px rgba(0,0,0,.25);cursor:pointer}
input[type=range]::-moz-range-track{height:4px;background:var(--line-2);border-radius:2px}
input[type=range]::-moz-range-thumb{height:14px;width:14px;border:0;border-radius:50%;background:var(--gold)}

/* =========================================================
   ACCUEIL
   ========================================================= */
#home-view{overflow-y:auto;background:var(--ivory)}
.container-x{max-width:1180px;margin:0 auto;padding:0 28px}
.home-header{position:sticky;top:0;z-index:20;background:rgba(247,245,241,.88);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.home-header .container-x{height:72px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{display:flex;align-items:center;gap:12px}
.brand-mark{width:42px;height:42px;border-radius:12px;background:var(--ink);color:var(--gold-100);display:flex;align-items:center;justify-content:center;font-size:17px;box-shadow:inset 0 0 0 1px rgba(176,141,87,.55),var(--shadow-md)}
.brand-name{font-family:var(--serif);font-size:23px;font-weight:700;color:var(--ink);line-height:1}
.brand-tag{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-600);font-weight:600;margin-top:4px}
.home-hero{padding:54px 0 30px}
.home-hero .container-x{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap}
.eyebrow{font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold-600);font-weight:600}
.hero-title{font-family:var(--serif);font-size:54px;line-height:1;font-weight:600;color:var(--ink);margin-top:10px}
.hero-sub{color:var(--muted);font-size:15px;margin-top:12px;max-width:520px}
.hero-search{width:300px;max-width:100%}
.projects-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:22px;padding-bottom:64px}
.project-card{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;cursor:pointer;transition:transform .2s,box-shadow .2s,border-color .2s;display:flex;flex-direction:column;outline:none}
.project-card:hover,.project-card:focus-visible{transform:translateY(-3px);box-shadow:var(--shadow-lg);border-color:var(--line-2)}
.pc-cover{position:relative;height:130px;background:linear-gradient(135deg,#1B2333 0%,#2E3C56 100%);background-size:cover;background-position:center}
.pc-cover:not(.has-img)::before{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(201,169,112,.45) 1px,transparent 1.2px);background-size:16px 16px}
.pc-cover-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(27,35,51,.1),rgba(27,35,51,.55))}
.pc-theme{position:absolute;left:14px;top:14px;display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 10px;border-radius:999px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.28);color:#fff;font-size:11.5px;font-weight:600;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.pc-actions{position:absolute;right:10px;top:10px;display:flex;gap:6px;opacity:0;transform:translateY(-4px);transition:.2s}
.project-card:hover .pc-actions,.project-card:focus-within .pc-actions{opacity:1;transform:none}
.pc-actions button{width:32px;height:32px;border-radius:9px;background:rgba(255,255,255,.94);color:var(--ink-3);display:flex;align-items:center;justify-content:center;font-size:13px;box-shadow:var(--shadow-sm);transition:.15s}
.pc-actions button:hover{background:#fff;color:var(--ink)}
.pc-actions button.danger:hover{color:var(--danger)}
.pc-emblem{position:absolute;left:18px;bottom:-22px;width:46px;height:46px;border-radius:14px;background:#fff;border:1px solid var(--line);color:var(--gold-600);display:flex;align-items:center;justify-content:center;font-size:18px;box-shadow:var(--shadow-md)}
.pc-body{padding:32px 18px 18px;display:flex;flex-direction:column;gap:6px;flex:1}
.pc-title{font-family:var(--serif);font-size:25px;font-weight:700;color:var(--ink);line-height:1.1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pc-date{font-size:12.5px;color:var(--muted);display:flex;gap:7px;align-items:center}
.pc-stats{display:flex;gap:16px;font-size:12.5px;color:var(--ink-3);font-weight:500;margin-top:6px}
.pc-stats i{color:var(--faint);margin-right:5px}
.pc-progress{display:flex;align-items:center;gap:10px;font-size:11.5px;color:var(--muted);font-weight:600;margin-top:auto;padding-top:12px}
.pc-bar{flex:1;height:6px;background:#F1EDE6;border-radius:99px;overflow:hidden}
.pc-bar span{display:block;height:100%;background:linear-gradient(90deg,var(--gold),#CDAE77);border-radius:99px}
.project-new{border:1.5px dashed var(--line-2);border-radius:18px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:290px;color:var(--muted);transition:.2s}
.project-new:hover{border-color:var(--gold);background:var(--gold-50);color:var(--ink)}
.pn-icon{width:54px;height:54px;border-radius:50%;background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--gold-600);font-size:18px;box-shadow:var(--shadow-sm);margin-bottom:4px}
.pn-title{font-weight:700;color:var(--ink);font-size:15px}
.pn-sub{font-size:12.5px}
.empty-state{display:flex;flex-direction:column;align-items:center;text-align:center;padding:64px 20px 90px}
.empty-illu{position:relative;width:140px;height:110px;margin-bottom:26px}
.empty-illu .t{position:absolute;left:35px;top:20px;width:70px;height:70px;border-radius:50%;background:#fff;border:1.5px solid var(--line-2);box-shadow:var(--shadow-md);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:22px}
.empty-illu .s{position:absolute;width:20px;height:20px;border-radius:50%;background:var(--gold-50);border:1.5px solid var(--gold)}
.empty-title{font-family:var(--serif);font-size:32px;font-weight:700;color:var(--ink)}
.empty-text{color:var(--muted);max-width:420px;margin:8px 0 24px}
.no-results{padding:40px 0;text-align:center;color:var(--muted)}

/* =========================================================
   ÉDITEUR — EN-TÊTE
   ========================================================= */
#editor-view:not(.hide){display:flex;flex-direction:column}
.editor-header{height:64px;flex-shrink:0;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 16px;z-index:40;position:relative}
.eh-left{display:flex;align-items:center;gap:10px;min-width:0}
.eh-right{display:flex;align-items:center;gap:8px;flex-shrink:0}
.divider-v{width:1px;height:28px;background:var(--line);margin:0 4px}
.editor-title{font-family:var(--serif);font-size:23px;font-weight:700;color:var(--ink);line-height:1.05;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:30vw}
.editor-sub{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--muted);margin-top:2px;white-space:nowrap}
.dot-sep{width:3px;height:3px;border-radius:50%;background:var(--faint)}
#save-status{color:var(--success);font-weight:500}
.progress-pill{display:flex;align-items:center;gap:12px;height:38px;padding:0 14px;border:1px solid var(--line);border-radius:10px;background:#FCFBF9;font-size:12.5px;color:var(--muted);white-space:nowrap}
.progress-pill strong{color:var(--ink)}
.progress-pill .bar{width:60px;height:5px;background:#EDE8E0;border-radius:99px;overflow:hidden}
.progress-pill .bar span{display:block;height:100%;width:0;background:var(--success);transition:width .3s}
.seats-chip{display:inline-flex;align-items:center;gap:6px;padding-left:12px;border-left:1px solid var(--line)}
.seats-chip.warn{color:var(--danger);font-weight:600}
.opacity-ctrl{display:flex;align-items:center;gap:8px;height:38px;padding:0 12px;border:1px solid var(--line);border-radius:10px;background:#fff;font-size:12px;color:var(--muted)}
.opacity-ctrl span{width:34px;text-align:right;font-weight:600;color:var(--ink-3);font-variant-numeric:tabular-nums}

/* =========================================================
   ÉDITEUR — BARRE LATÉRALE
   ========================================================= */
.editor-body{flex:1;display:flex;min-height:0;position:relative}
.sidebar{width:330px;flex-shrink:0;background:#fff;border-right:1px solid var(--line);display:flex;flex-direction:column;z-index:30}
.sb-section{padding:18px;border-bottom:1px solid var(--line)}
.sb-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:14px}
.sb-title{font-family:var(--serif);font-size:26px;font-weight:700;color:var(--ink);line-height:1}
.sb-sub{font-size:12px;color:var(--muted);margin-top:5px}
.sb-sub strong{color:var(--ink)}
.link-btn{font-size:12.5px;font-weight:600;color:var(--gold-600);display:inline-flex;align-items:center;gap:7px;margin-top:12px}
.link-btn:hover{color:var(--ink)}
.guest-list{flex:1;overflow-y:auto;padding:4px 10px 16px}
.gl-section-title{display:flex;align-items:center;justify-content:space-between;font-size:10.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);padding:14px 8px 6px}
.guest-item{display:flex;align-items:center;gap:10px;padding:7px 8px;border-radius:12px;border:1px solid transparent;cursor:grab;transition:background .15s,border-color .15s}
.guest-item:hover{background:#FAF8F4;border-color:var(--line)}
.guest-item.is-placed{cursor:pointer}
.guest-item.is-dragging{opacity:.4}
.guest-meta{min-width:0;flex:1}
.guest-name{font-size:13.5px;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.guest-sub{font-size:11.5px;color:var(--faint);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.guest-item.is-placed .guest-sub{color:var(--success)}
.guest-actions{display:flex;gap:2px;opacity:0;transition:opacity .15s}
.guest-item:hover .guest-actions,.guest-item:focus-within .guest-actions{opacity:1}
.ga-btn{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--faint);font-size:12px;transition:.15s}
.ga-btn:hover{background:#F1EDE6;color:var(--ink)}
.ga-btn.danger:hover{background:var(--danger-bg);color:var(--danger)}
.gl-empty{text-align:center;padding:40px 16px;color:var(--muted);font-size:13px}
.gl-empty i{font-size:26px;color:var(--line-2);display:block;margin-bottom:12px}
.sb-hint{padding:12px 18px;border-top:1px solid var(--line);font-size:11.5px;color:var(--muted);background:#FCFBF9;display:flex;gap:9px;align-items:center}
.sb-hint i{color:var(--gold)}
.sidebar-backdrop{display:none}
/* Barre latérale compacte sur les écrans bas ou étroits : plus de place pour la liste des invités */
@media (max-height:900px), (max-width:1023px){
  .sb-section{padding:12px 14px}
  .sb-head{margin-bottom:8px}
  .sb-title{font-size:22px}
  .sb-sub{margin-top:2px}
  .sidebar .stack-3{gap:8px}
  .sidebar .input{height:38px}
  .sidebar .btn{height:36px}
  .link-btn{margin-top:6px}
  .guest-list{padding:0 8px 10px}
  .gl-section-title{padding:8px 8px 4px}
  .guest-item{padding:4px 8px}
  .sb-hint{display:none}
}

/* =========================================================
   ÉDITEUR — CANEVAS
   ========================================================= */
.room-canvas{flex:1;position:relative;overflow:hidden;background:var(--canvas);cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none}
.room-canvas.is-panning{cursor:grabbing}
.three-root{position:absolute;inset:0;z-index:0}
.three-root canvas{display:block;width:100%;height:100%;outline:none}
.flat-view{position:absolute;inset:0;z-index:0;background:#F7F4EE}
.flat-view{touch-action:none}
.flat-view svg{width:100%;height:100%;display:block}
.f2-elem-g,.f2-table-g{cursor:pointer}
.f2-elem-g.f2-sel .f2-elem,.f2-table-g.f2-sel .f2-table{stroke:#B08D57;stroke-width:4}
.f2-table{fill:#FFFFFF;stroke:#C9B188;stroke-width:3}
.f2-elem{fill:#E9E4DA;stroke:#CFC6B6;stroke-width:2}
.f2-elem.is-zone{fill:rgba(176,141,87,.08);stroke:#B08D57;stroke-dasharray:12 8}
.f2-chair{stroke:#B8AE9E;stroke-width:1.5;stroke-dasharray:4 3}
.f2-chair.is-taken{stroke:#FFFFFF;stroke-width:2;stroke-dasharray:none}
.f2-plus{fill:#9C9385;font:600 14px Inter,Arial,sans-serif;text-anchor:middle;dominant-baseline:central;pointer-events:none}
.f2-initials{fill:#FFFFFF;font:700 11px Inter,Arial,sans-serif;text-anchor:middle;dominant-baseline:central;pointer-events:none}
.f2-seat{cursor:pointer}
.f2-seat:hover .f2-chair{stroke:#B08D57;stroke-width:3}
.f2-table-g{cursor:pointer}
.f2-tlabel{font:700 16px 'Cormorant Garamond',Georgia,serif;fill:#1B2333;text-anchor:middle;pointer-events:none}
.f2-tsub{font:600 12px Inter,Arial,sans-serif;fill:#6F6B64;text-anchor:middle;pointer-events:none}
.f2-name{font:600 10px Inter,Arial,sans-serif;fill:#1B2333;text-anchor:middle;pointer-events:none}
.f2-label{font:600 11px Inter,Arial,sans-serif;fill:#6F6B64;text-anchor:middle;dominant-baseline:middle;pointer-events:none}
.f2-drop .f2-chair{stroke:#E3B565;stroke-width:4}
.f2-table-g.f2-drop .f2-table{stroke:#E3B565;stroke-width:5}
.room-canvas.is-hovering{cursor:pointer}
.tip3d{position:absolute;z-index:58;pointer-events:none;background:var(--ink);color:#fff;font-size:12px;font-weight:600;padding:6px 10px;border-radius:8px;box-shadow:var(--shadow-md);white-space:nowrap}
.hint3d{left:16px;bottom:62px;display:flex;gap:14px;padding:7px 12px;background:rgba(255,255,255,.92);border:1px solid var(--line);border-radius:10px;font-size:11.5px;color:var(--muted);box-shadow:var(--shadow-sm)}
.hint3d b{color:var(--ink-3);font-weight:600}
.view-seg{display:inline-flex;background:#F1EDE6;border-radius:9px;padding:3px;gap:2px;margin:0 2px}
.zoom-ctrl .view-seg button{height:28px;min-width:0;padding:0 10px;font-size:12px;font-weight:700;color:var(--muted);border-radius:7px}
.zoom-ctrl .view-seg button.is-on{background:#fff;color:var(--ink);box-shadow:var(--shadow-sm)}
.pi-icon.pi-3d{width:76px;height:64px;padding:0;overflow:hidden;background:radial-gradient(circle at 50% 45%,#FFFFFF,#F1ECE4 75%)}
.pi-icon.pi-3d img{width:76px;height:64px;object-fit:contain;display:block}
.picker-item:hover .pi-icon.pi-3d{background:radial-gradient(circle at 50% 45%,#FFFFFF,#F8F2E8 75%)}
.canvas-error .ec-icon{background:var(--danger-bg);color:var(--danger);border-color:#F3D6D1}
@media (max-width:640px){.hint3d{display:none}}

/* Overlays du canevas */
.ov{position:absolute;z-index:50}
.tool-stack{top:16px;right:16px;display:flex;flex-direction:column;gap:8px}
.tool-btn{width:42px;height:42px;border-radius:12px;background:rgba(255,255,255,.96);border:1px solid var(--line);box-shadow:var(--shadow-md);color:var(--ink-3);display:flex;align-items:center;justify-content:center;font-size:15px;transition:.15s}
.tool-btn:hover{color:var(--ink);border-color:var(--line-2)}
.tool-btn.is-on{background:var(--ink);color:var(--gold-100);border-color:var(--ink)}
.br-stack{right:16px;bottom:16px;display:flex;flex-direction:column;align-items:flex-end;gap:10px;width:max-content}
.fab{white-space:nowrap;flex-shrink:0;height:48px;padding:0 20px 0 12px;border-radius:999px;background:var(--gold);color:#fff;font-weight:700;font-size:14px;display:inline-flex;align-items:center;gap:10px;box-shadow:0 10px 24px rgba(151,118,63,.38);transition:.15s}
.fab:hover{background:var(--gold-600);transform:translateY(-1px)}
.fab .fab-ico{width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,.22);display:flex;align-items:center;justify-content:center;font-size:13px}
.zoom-ctrl{display:flex;align-items:center;gap:2px;padding:4px;background:rgba(255,255,255,.97);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow-md)}
.zoom-ctrl button{height:34px;min-width:34px;border-radius:8px;color:var(--ink-3);display:flex;align-items:center;justify-content:center;font-size:13px;gap:6px;transition:.15s}
.zoom-ctrl button:hover{background:#F4F1EC;color:var(--ink)}
.zoom-ctrl .fit{padding:0 10px;font-size:12px;font-weight:600}
.zoom-ctrl .zl{min-width:48px;text-align:center;font-size:12px;font-weight:600;color:var(--ink-3);font-variant-numeric:tabular-nums}
.zoom-ctrl .sep{width:1px;height:20px;background:var(--line);margin:0 2px}
.legend{left:16px;bottom:16px;display:flex;gap:14px;padding:8px 14px;background:rgba(255,255,255,.94);border:1px solid var(--line);border-radius:10px;font-size:11.5px;color:var(--ink-3);font-weight:600;box-shadow:var(--shadow-sm)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend b{width:10px;height:10px;border-radius:50%;display:inline-block}

.sel-toolbar{position:absolute;top:16px;left:50%;transform:translateX(-50%);z-index:55;display:flex;align-items:center;gap:3px;padding:6px;background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 14px 34px rgba(27,35,51,.16);max-width:calc(100% - 132px);overflow-x:auto;animation:tb-in .18s ease}
@keyframes tb-in{from{opacity:0;transform:translate(-50%,-6px)}to{opacity:1;transform:translate(-50%,0)}}
.tb-ident{display:flex;align-items:center;gap:6px;padding-left:2px;flex-shrink:0}
.tb-icon{width:30px;height:30px;border-radius:9px;background:var(--gold-50);color:var(--gold-600);display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0}
.tb-input{height:32px;width:132px;border:1px solid transparent;border-radius:8px;padding:0 8px;font-weight:600;font-size:13.5px;color:var(--ink);background:transparent}
.tb-input:hover{border-color:var(--line)}
.tb-input:focus{outline:none;border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(176,141,87,.15)}
.tb-name{font-weight:600;font-size:13.5px;color:var(--ink);padding:0 6px;white-space:nowrap}
.tb-meta{font-size:12px;color:var(--muted);white-space:nowrap;padding:0 6px;flex-shrink:0}
.tb-sep{width:1px;height:24px;background:var(--line);margin:0 3px;flex-shrink:0}
.tb-btn{height:34px;min-width:34px;padding:0 9px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;gap:7px;color:var(--ink-3);font-size:13px;font-weight:600;white-space:nowrap;transition:.15s;flex-shrink:0}
.tb-btn:hover{background:#F4F1EC;color:var(--ink)}
.tb-btn.is-on{background:var(--gold-50);color:var(--gold-600)}
.tb-btn.danger:hover{background:var(--danger-bg);color:var(--danger)}
.tb-locked{font-size:12px;color:var(--gold-600);font-weight:600;display:inline-flex;gap:6px;align-items:center;padding:0 8px;white-space:nowrap}

.canvas-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:45;padding:20px}
.empty-card{pointer-events:auto;background:rgba(255,255,255,.97);border:1px solid var(--line);border-radius:22px;padding:34px 32px 28px;max-width:460px;text-align:center;box-shadow:var(--shadow-lg)}
.empty-card .ec-icon{width:60px;height:60px;border-radius:50%;margin:0 auto 16px;background:var(--gold-50);color:var(--gold-600);display:flex;align-items:center;justify-content:center;font-size:22px;border:1px solid var(--gold-100)}
.empty-card h3{font-family:var(--serif);font-size:30px;font-weight:700;color:var(--ink);line-height:1.1}
.empty-card p{color:var(--muted);margin:8px 0 22px}
.empty-card .row{justify-content:center;flex-wrap:wrap}

/* =========================================================
   MODALES
   ========================================================= */
.modal-backdrop{position:fixed;inset:0;z-index:100;background:rgba(18,24,36,.5);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);display:none;align-items:center;justify-content:center;padding:16px}
.modal-backdrop.is-open{display:flex;animation:fade .18s ease}
@keyframes fade{from{opacity:0}to{opacity:1}}
.modal{background:#fff;border-radius:20px;box-shadow:var(--shadow-xl);width:100%;max-width:440px;max-height:calc(100vh - 32px);max-height:calc(100dvh - 32px);display:flex;flex-direction:column;animation:pop .24s cubic-bezier(.2,.9,.3,1.15)}
@keyframes pop{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:none}}
.modal-sm{max-width:400px}.modal-md{max-width:540px}.modal-lg{max-width:780px}
.modal-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:22px 24px 4px}
.modal-title{font-family:var(--serif);font-size:28px;font-weight:700;color:var(--ink);line-height:1.1}
.modal-sub{font-size:13px;color:var(--muted);margin-top:4px}
.modal-close{width:34px;height:34px;border-radius:10px;color:var(--faint);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.15s}
.modal-close:hover{background:#F4F1EC;color:var(--ink)}
.modal-body{padding:18px 24px;overflow-y:auto}
.modal-foot{display:flex;justify-content:flex-end;gap:10px;padding:14px 24px 20px;border-top:1px solid var(--line);flex-wrap:wrap}

.theme-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.theme-opt{display:flex;flex-direction:column;align-items:center;gap:8px;padding:16px 8px;border:1.5px solid var(--line);border-radius:14px;color:var(--muted);font-size:12.5px;font-weight:600;transition:.15s}
.theme-opt i{font-size:22px;color:var(--faint);transition:.15s}
.theme-opt:hover{border-color:var(--line-2);color:var(--ink)}
.theme-opt.is-active{border-color:var(--gold);background:var(--gold-50);color:var(--ink)}
.theme-opt.is-active i{color:var(--gold-600)}
.bg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.bg-opt{position:relative;height:74px;border-radius:12px;border:1.5px solid var(--line);background-size:cover;background-position:center;background-color:#F4F1EC;transition:.15s;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:12px;font-weight:600;color:var(--muted)}
.bg-opt:hover{border-color:var(--line-2)}
.bg-opt.is-active{border-color:var(--gold);box-shadow:0 0 0 3px rgba(176,141,87,.22)}
.bg-check{position:absolute;right:6px;top:6px;width:20px;height:20px;border-radius:50%;background:var(--gold);color:#fff;font-size:10px;display:none;align-items:center;justify-content:center}
.bg-opt.is-active .bg-check{display:flex}

.option-card{width:100%;display:flex;align-items:center;gap:14px;padding:14px;border:1px solid var(--line);border-radius:14px;text-align:left;transition:.15s}
.option-card:hover{border-color:var(--gold);background:var(--gold-50)}
.oc-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
.oc-title{font-weight:700;font-size:14px;color:var(--ink)}
.oc-sub{font-size:12px;color:var(--muted);margin-top:2px}
.oc-arrow{margin-left:auto;color:var(--faint)}

.picker-section{margin-bottom:22px}
.picker-section h4{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
.picker-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(118px,1fr));gap:8px}
.picker-item{display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 6px 12px;border:1px solid var(--line);border-radius:14px;background:#fff;transition:.15s}
.picker-item:hover{border-color:var(--gold);background:var(--gold-50);transform:translateY(-1px)}
.pi-icon{width:42px;height:42px;border-radius:12px;background:#F6F3EE;color:var(--ink-3);display:flex;align-items:center;justify-content:center;font-size:17px;transition:.15s}
.pi-icon svg{width:30px;height:30px}
.picker-item:hover .pi-icon{background:#fff;color:var(--gold-600)}
.pi-name{font-size:12.5px;font-weight:600;color:var(--ink);text-align:center;line-height:1.2}
.pi-dim{font-size:10.5px;color:var(--faint)}
.layout-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.layout-card{display:flex;align-items:center;gap:14px;padding:14px;border-radius:14px;background:var(--ink);color:#fff;text-align:left;transition:.15s}
.layout-card:hover{background:var(--ink-2)}
.layout-card svg{width:50px;height:50px;flex-shrink:0}
.layout-card strong{display:block;font-size:14px}
.layout-card span{font-size:12px;color:rgba(255,255,255,.65)}
.picker-empty{text-align:center;padding:30px;color:var(--muted)}

.seat-layout{display:grid;grid-template-columns:auto 1fr auto;grid-template-rows:auto auto auto;gap:10px 12px;align-items:center;justify-items:center;margin-top:12px}
.seat-table{grid-column:2;grid-row:2;width:100%;height:74px;border:1.5px solid var(--line-2);border-radius:10px;background:#FCFBF9;display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--faint);font-weight:600}
.seat-round{display:flex;align-items:center;gap:18px;margin-top:12px;padding:14px;border:1px solid var(--line);border-radius:14px;background:#FCFBF9}
.seat-round-table{width:56px;height:56px;border-radius:50%;border:1.5px solid var(--line-2);background:#fff;flex-shrink:0}
.stepper-label{font-size:10px;color:var(--faint);text-transform:uppercase;letter-spacing:.1em;font-weight:700;margin-bottom:4px;text-align:center}
.stepper{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:10px;background:#fff;overflow:hidden}
.stepper button{width:32px;height:32px;color:var(--ink-3);font-size:16px;font-weight:600;transition:.15s}
.stepper button:hover{background:#F4F1EC;color:var(--ink)}
.stepper .val{min-width:28px;text-align:center;font-weight:700;font-size:14px;color:var(--ink);font-variant-numeric:tabular-nums}
.total-chip{font-size:12px;font-weight:700;color:var(--gold-600);background:var(--gold-50);padding:3px 10px;border-radius:999px}

.current-guest{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--line);border-radius:14px;background:#FCFBF9}
.current-guest .cg-name{font-weight:700;color:var(--ink)}
.current-guest .cg-sub{font-size:12px;color:var(--muted)}
.current-empty{display:flex;align-items:center;gap:10px;padding:12px 14px;border:1px dashed var(--line-2);border-radius:14px;color:var(--muted);font-size:13px}
.assign-list-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.assign-list-head .label{margin:0}
.check{display:inline-flex;align-items:center;gap:7px;font-size:12px;color:var(--muted);cursor:pointer}
.check input{accent-color:var(--gold);width:15px;height:15px}
.assign-list{display:flex;flex-direction:column;gap:4px;max-height:300px;overflow-y:auto;margin:0 -6px;padding:0 6px}
.assign-item{width:100%;display:flex;align-items:center;gap:12px;padding:8px 10px;border-radius:12px;border:1px solid transparent;text-align:left;transition:.15s}
.assign-item:hover{background:var(--gold-50);border-color:var(--gold-100)}
.assign-item .ai-name{font-weight:600;color:var(--ink);font-size:13.5px}
.assign-item .ai-sub{font-size:11.5px;color:var(--faint)}
.assign-item .ai-go{margin-left:auto;color:var(--faint);font-size:12px}

.stat-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.stat-card{border:1px solid var(--line);border-radius:14px;padding:14px 16px;background:#FCFBF9}
.stat-card .v{font-family:var(--serif);font-size:34px;font-weight:700;color:var(--ink);line-height:1}
.stat-card .l{font-size:11.5px;color:var(--muted);margin-top:4px;font-weight:600}
.stat-card .s{font-size:11px;color:var(--faint);margin-top:2px}
.summary-alert{display:flex;gap:12px;margin-top:14px;padding:12px 14px;border-radius:12px;background:var(--gold-50);border:1px solid var(--gold-100);color:var(--ink-3);font-size:13px}
.summary-alert i{color:var(--gold-600);margin-top:3px}
.summary-alert p{color:var(--muted);margin-top:2px}
.summary-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-top:16px}
.summary-table{border:1px solid var(--line);border-radius:14px;padding:14px 16px;break-inside:avoid;page-break-inside:avoid}
.st-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px;border-bottom:1px solid var(--line);padding-bottom:8px;margin-bottom:6px}
.st-name{font-family:var(--serif);font-size:21px;font-weight:700;color:var(--ink);line-height:1.1}
.st-count{font-size:11.5px;color:var(--muted);font-weight:600;white-space:nowrap}
.st-list li{display:flex;align-items:center;gap:9px;font-size:13px;padding:3px 0}
.st-list .dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.st-empty{font-size:12.5px;color:var(--faint);font-style:italic;padding:3px 0}

.confirm-body{text-align:center;padding-top:28px}
.confirm-icon{width:52px;height:52px;border-radius:50%;margin:0 auto 14px;display:flex;align-items:center;justify-content:center;font-size:20px;background:var(--danger-bg);color:var(--danger)}
.confirm-icon.neutral{background:var(--gold-50);color:var(--gold-600)}
.confirm-body .modal-title{font-size:26px}
#confirm-modal .modal-foot{justify-content:center;border-top:0;padding-top:4px}

.kbd-list{display:grid;grid-template-columns:1fr auto;gap:10px 16px;font-size:13px;color:var(--ink-3)}
kbd{display:inline-block;font-family:inherit;font-size:11.5px;font-weight:600;padding:2px 7px;border:1px solid var(--line-2);border-bottom-width:2px;border-radius:6px;background:#FCFBF9;color:var(--ink);margin-left:3px}

/* =========================================================
   TOAST
   ========================================================= */
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);opacity:0;pointer-events:none;z-index:300;display:flex;align-items:center;gap:10px;background:var(--ink);color:#fff;padding:12px 16px;border-radius:12px;font-size:13.5px;font-weight:500;box-shadow:0 14px 34px rgba(18,24,36,.3);transition:opacity .25s ease,transform .25s ease;max-width:calc(100vw - 32px)}
.toast.is-visible{opacity:1;transform:translate(-50%,0);pointer-events:auto}
.toast-success i{color:#86CFA3}
.toast-error{background:#7E2F28}
.toast-error i{color:#FFB4A8}
.toast-info i{color:var(--gold-100)}
.toast-action{margin-left:6px;padding:5px 11px;border-radius:8px;background:rgba(255,255,255,.15);font-weight:700;font-size:12.5px;color:#fff;transition:.15s}
.toast-action:hover{background:rgba(255,255,255,.26)}


/* =========================================================
   RESPONSIVE
   ========================================================= */
.only-mobile{display:none}
@media (max-width:1180px){.hide-lg{display:none!important}}
@media (max-width:980px){.hide-md{display:none!important}}
@media (max-width:1023px){
  .only-mobile{display:inline-flex}
  .sidebar{position:fixed;top:64px;bottom:0;left:0;width:min(340px,88vw);transform:translateX(-102%);transition:transform .25s ease;z-index:80;box-shadow:var(--shadow-xl)}
  body.sidebar-open .sidebar{transform:none}
  body.sidebar-open .sidebar-backdrop{display:block;position:fixed;inset:64px 0 0 0;background:rgba(18,24,36,.35);z-index:70}
  .editor-title{max-width:40vw}
}
@media (max-width:640px){
  .container-x{padding:0 18px}
  .hero-title{font-size:40px}
  .home-hero{padding:34px 0 22px}
  .hide-sm{display:none!important}
  .editor-header{padding:0 10px;gap:6px}
  .eh-right{gap:6px}
  .btn-label{display:none}
  .eh-right .btn{padding:0 12px}
  .sel-toolbar{top:10px;max-width:calc(100% - 20px)}
  .tb-btn span,.tb-meta{display:none}
  .tool-stack{top:68px;right:10px}
  .br-stack{right:10px;bottom:10px}
  .fab .fab-label{display:none}
  .fab{padding:0;width:52px;justify-content:center}
  .fab .fab-ico{background:none;font-size:18px}
  .legend{display:none}
  .stat-cards{grid-template-columns:repeat(2,1fr)}
  .layout-grid{grid-template-columns:1fr}
  .modal-head{padding:20px 18px 4px}
  .modal-body{padding:16px 18px}
  .modal-foot{padding:12px 18px 18px}
}
@media (hover:none){
  .pc-actions,.guest-actions{opacity:1;transform:none}
  .chair-del{display:flex}
}

/* =========================================================
   IMPRESSION DU RÉSUMÉ
   ========================================================= */
@media print{
  html,body{height:auto;overflow:visible;background:#fff}
  body.print-summary>*:not(#export-modal){display:none!important}
  body.print-summary #export-modal{position:static;display:block;background:none;padding:0;backdrop-filter:none}
  body.print-summary #export-modal .modal{box-shadow:none;max-height:none;max-width:none;width:100%;animation:none;border-radius:0}
  body.print-summary #export-modal .modal-body{overflow:visible;max-height:none}
  body.print-summary .no-print{display:none!important}
}
