   ========================================================= */
function saveProjectsToStorage() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(projects)); return true; }
  catch (e) { showToast("Impossible d'enregistrer : le stockage du navigateur est plein ou indisponible", 'error'); return false; }
}
function loadProjectsFromStorage() {
  try { const saved = localStorage.getItem(STORAGE_KEY); if (saved) projects = JSON.parse(saved) || []; } catch (e) { projects = []; }
}
function saveCurrentProjectData() {
  const p = getCurrentProject(); if (!p) return;
  p.data.guests = clone(guests); p.data.tables = clone(tables); p.data.roomElements = clone(roomElements);
  p.data.showNames = showNames;
  p.date = new Date().toLocaleDateString('fr-FR'); p.updatedAt = Date.now();
  saveProjectsToStorage();
}
function persist() { saveCurrentProjectData(); markSaved(); }
function markSaved() {
  const d = new Date();
