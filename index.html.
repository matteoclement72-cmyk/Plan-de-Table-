</head>
<body>

<!-- ======================= ACCUEIL ======================= -->
<div id="home-view" class="view">
  <header class="home-header">
    <div class="container-x">
      <div class="brand">
        <div class="brand-mark"><i class="fa-solid fa-champagne-glasses"></i></div>
        <div>
          <div class="brand-name">Mes Plans de Table</div>
          <div class="brand-tag">Plans de table en 3D</div>
        </div>
      </div>
      <div class="row gap-2">
        <button class="btn btn-ghost" onclick="triggerImport()" title="Importer un fichier de sauvegarde (.json)"><i class="fa-solid fa-file-import"></i><span class="hide-sm">Importer</span></button>
        <button class="btn btn-primary" onclick="openProjectModal()"><i class="fa-solid fa-plus"></i><span>Nouveau projet</span></button>
      </div>
    </div>
  </header>

  <section class="home-hero">
    <div class="container-x">
      <div>
        <div class="eyebrow" id="home-count">Vos événements</div>
        <h1 class="hero-title">Vos plans de table</h1>
        <p class="hero-sub">Concevez votre salle en 3D, installez chaque invité à la bonne place et imprimez un plan impeccable.</p>
      </div>
      <div class="input-icon hero-search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input id="project-search" class="input" placeholder="Rechercher un événement…" oninput="renderProjectsHome()" autocomplete="off">
      </div>
    </div>
  </section>

  <main class="container-x">
    <div id="projects-grid" class="projects-grid"></div>
    <div id="no-results-state" class="no-results hide">Aucun événement ne correspond à votre recherche.</div>
    <div id="empty-projects-state" class="empty-state hide">
      <div class="empty-illu">
        <div class="t"><i class="fa-solid fa-champagne-glasses"></i></div>
        <span class="s" style="left:60px;top:0"></span>
        <span class="s" style="left:15px;top:44px"></span>
        <span class="s" style="left:105px;top:44px"></span>
        <span class="s" style="left:60px;top:90px"></span>
      </div>
      <h2 class="empty-title">Votre premier plan vous attend</h2>
      <p class="empty-text">Créez un événement, ajoutez vos invités et placez-les en quelques glisser-déposer.</p>
      <button class="btn btn-gold" onclick="openProjectModal()"><i class="fa-solid fa-plus"></i> Créer mon premier plan</button>
    </div>
  </main>
  <input type="file" id="import-input" accept=".json,application/json" class="hide" onchange="handleImport(event)">
</div>

<!-- ======================= ÉDITEUR ======================= -->
<div id="editor-view" class="view hide">
  <header class="editor-header">
    <div class="eh-left">
      <button class="btn-icon" onclick="closeProject()" title="Retour à mes projets" aria-label="Retour"><i class="fa-solid fa-arrow-left"></i></button>
      <button class="btn-icon only-mobile" onclick="toggleSidebar()" title="Invités" aria-label="Afficher les invités"><i class="fa-solid fa-user-group"></i></button>
      <div class="divider-v hide-sm"></div>
      <div class="min-w-0">
        <h1 id="editor-project-title" class="editor-title">Titre du projet</h1>
        <div class="editor-sub">
          <span id="editor-theme-label">Événement</span>
          <span class="dot-sep hide-sm"></span>
          <span id="save-status" class="hide-sm"><i class="fa-solid fa-check"></i> Enregistré</span>
        </div>
      </div>
    </div>

    <div class="eh-right">
      <div class="btn-group">
        <button id="btn-undo" class="btn-icon" onclick="undo()" disabled title="Annuler (Ctrl+Z)" aria-label="Annuler"><i class="fa-solid fa-arrow-rotate-left"></i></button>
        <button id="btn-redo" class="btn-icon" onclick="redo()" disabled title="Rétablir (Ctrl+Y)" aria-label="Rétablir"><i class="fa-solid fa-arrow-rotate-right"></i></button>
      </div>

      <div id="opacity-control-container" class="opacity-ctrl hide-lg hide" title="Opacité de l'image de fond">
        <i class="fa-regular fa-image"></i>
        <input type="range" id="bg-opacity-slider" min="0" max="100" value="50" oninput="updateBackgroundOpacity(this.value)" aria-label="Opacité du fond">
        <span id="opacity-value">50%</span>
      </div>

      <div class="progress-pill hide-md" title="Invités placés">
        <span>Placés <strong id="stat-placed">0</strong>/<span id="stat-total">0</span></span>
        <div class="bar"><span id="stat-bar"></span></div>
        <span id="stat-seats-wrap" class="seats-chip"><i class="fa-solid fa-chair"></i><span id="stat-seats">0</span> places</span>
      </div>

      <button class="btn btn-outline" onclick="openExportModal()" title="Résumé du plan"><i class="fa-regular fa-eye"></i><span class="btn-label">Résumé</span></button>
      <button class="btn btn-primary" onclick="openSaveModal()" title="Enregistrer / exporter"><i class="fa-solid fa-download"></i><span class="btn-label">Enregistrer</span></button>
    </div>
  </header>

  <div class="editor-body">
    <div id="sidebar-backdrop" class="sidebar-backdrop" onclick="toggleSidebar(false)"></div>

    <!-- Barre latérale invités -->
    <aside id="sidebar" class="sidebar">
      <div class="sb-section">
        <div class="sb-head">
          <div>
            <h2 class="sb-title">Invités</h2>
            <p class="sb-sub"><strong id="sb-placed">0</strong> placés sur <strong id="guest-count-badge">0</strong></p>
          </div>
          <button class="btn-icon only-mobile" onclick="toggleSidebar(false)" aria-label="Fermer"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form id="add-guest-form" class="stack-3" onsubmit="addGuest(event)">
          <div class="input-icon">
            <i class="fa-regular fa-user"></i>
            <input type="text" id="new-guest-name" class="input" placeholder="Prénom et nom de l'invité" autocomplete="off" required>
          </div>
          <div id="new-guest-cat" class="seg"></div>
          <button type="submit" class="btn btn-primary w-full"><i class="fa-solid fa-plus"></i> Ajouter l'invité</button>
        </form>
        <button class="link-btn" onclick="openBulkModal()"><i class="fa-solid fa-list-ul"></i> Ajouter une liste d'invités</button>
      </div>

      <div class="sb-section stack-3" style="padding-top:14px;padding-bottom:14px">
        <div class="input-icon">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="search-guest" class="input input-sm" oninput="renderGuestList()" placeholder="Rechercher un invité…" autocomplete="off">
        </div>
        <div id="filter-pills" class="pill-row"></div>
      </div>

      <div id="guest-list-container" class="guest-list"></div>
      <div class="sb-hint"><i class="fa-regular fa-hand-pointer"></i> Glissez un invité sur une chaise ou une table</div>
    </aside>

    <!-- Canevas -->
    <main id="room-canvas" class="room-canvas">
      <div id="three-root" class="three-root"></div>
      <div id="flat-view" class="flat-view hide"><svg id="flat-svg" xmlns="http://www.w3.org/2000/svg"></svg></div>
      <div id="tip3d" class="tip3d hide"></div>

      <div id="canvas-error" class="canvas-empty canvas-error hide" data-ui>
        <div class="empty-card">
          <div class="ec-icon"><i class="fa-solid fa-cube"></i></div>
          <h3>Affichage 3D indisponible</h3>
          <p id="canvas-error-msg">Le moteur 3D n'a pas pu démarrer.</p>
          <div class="row gap-2"><button class="btn btn-primary" onclick="location.reload()"><i class="fa-solid fa-rotate"></i> Recharger la page</button></div>
        </div>
      </div>

      <div id="canvas-empty" class="canvas-empty hide" data-ui>
        <div class="empty-card">
          <div class="ec-icon"><i class="fa-solid fa-cube"></i></div>
          <h3>Votre salle est vide</h3>
          <p>Ajoutez vos tables une à une, ou générez une disposition complète en un clic.</p>
          <div class="row gap-2">
            <button class="btn btn-gold" onclick="openElementPicker()"><i class="fa-solid fa-plus"></i> Ajouter une table</button>
            <button class="btn btn-outline" onclick="openGeneratePlanModal('plan_u')">Plan en U</button>
            <button class="btn btn-outline" onclick="openGeneratePlanModal('plan_ii')">Plan en II</button>
          </div>
        </div>
      </div>

      <div id="selection-toolbar" class="sel-toolbar hide" data-ui></div>

      <div class="ov tool-stack" data-ui>
        <button id="btn-global-lock" class="tool-btn" onclick="toggleGlobalLock()" title="Verrouiller la disposition"><i id="global-lock-icon" class="fa-solid fa-lock-open"></i></button>
        <button id="btn-names" class="tool-btn" onclick="toggleShowNames()" title="Afficher les noms sur le plan"><i class="fa-solid fa-signature"></i></button>
        <button class="tool-btn hide-sm" onclick="openModal('shortcuts-modal')" title="Commandes et raccourcis"><i class="fa-regular fa-keyboard"></i></button>
      </div>

      <div id="hint3d" class="ov hint3d" data-ui>
        <span><b>Glisser</b> : pivoter</span>
        <span><b>Clic droit</b> ou <b>Maj</b> : déplacer la vue</span>
        <span><b>Molette</b> : zoom</span>
      </div>

      <div class="ov legend" data-ui>
        <span><b style="background:var(--homme)"></b>Homme</span>
        <span><b style="background:var(--femme)"></b>Femme</span>
        <span><b style="background:var(--enfant)"></b>Enfant</span>
      </div>

      <div class="ov br-stack" data-ui>
        <button id="btn-add-element" class="fab" onclick="openElementPicker()" title="Ajouter un élément">
          <span class="fab-ico"><i class="fa-solid fa-plus"></i></span><span class="fab-label">Ajouter un élément</span>
        </button>
        <div class="zoom-ctrl">
          <button onclick="orbitBy(-1)" title="Pivoter la vue vers la gauche (Q)" aria-label="Pivoter à gauche"><i class="fa-solid fa-rotate-left"></i></button>
          <button onclick="orbitBy(1)" title="Pivoter la vue vers la droite (E)" aria-label="Pivoter à droite"><i class="fa-solid fa-rotate-right"></i></button>
          <span class="sep"></span>
          <button onclick="zoomBy(1/1.25)" title="Dézoomer (−)" aria-label="Dézoomer"><i class="fa-solid fa-minus"></i></button>
          <span id="zoom-level-label" class="zl">100%</span>
          <button onclick="zoomBy(1.25)" title="Zoomer (+)" aria-label="Zoomer"><i class="fa-solid fa-plus"></i></button>
          <span class="sep"></span>
          <div class="view-seg" role="group" aria-label="Type de vue">
            <button id="btn-view-2d" onclick="setViewMode('2d')" title="Plan en 2D (vue à plat)">2D</button>
            <button id="btn-view-3d" class="is-on" onclick="setViewMode('3d')" title="Vue en perspective">3D</button>
            <button id="btn-view-top" onclick="setViewMode('top')" title="Vue de dessus (T)">Dessus</button>
          </div>
          <button class="fit" onclick="resetZoomPan()" title="Ajuster le plan à l'écran (0)"><i class="fa-solid fa-expand"></i><span class="hide-sm">Centrer</span></button>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- ======================= MODALES ======================= -->

<!-- Projet : création / modification -->
<div id="project-modal" class="modal-backdrop" role="dialog" aria-modal="true">
  <form class="modal modal-md" onsubmit="event.preventDefault(); submitProjectModal();">
    <div class="modal-head">
      <div><h3 id="pm-title" class="modal-title">Nouvel événement</h3><p id="pm-sub" class="modal-sub">Quelques informations pour démarrer votre plan.</p></div>
      <button type="button" class="modal-close" onclick="closeModal('project-modal')" aria-label="Fermer"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body stack-5">
      <div>
        <label class="label" for="pm-name">Nom de l'événement</label>
        <input id="pm-name" class="input" placeholder="Ex. Mariage de Camille & Hugo" autocomplete="off" data-autofocus>
      </div>
      <div>
        <label class="label" for="pm-date">Date de l'événement <span class="label-opt">(facultatif)</span></label>
        <input id="pm-date" type="date" class="input">
      </div>
      <div>
        <span class="label">Type d'événement</span>
        <div id="pm-themes" class="theme-grid"></div>
      </div>
      <div>
        <span class="label">Fond du plan</span>
        <div id="pm-bgs" class="bg-grid"></div>
        <p class="help">Le fond s'affiche en transparence sous le plan, son opacité est réglable.</p>
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" onclick="closeModal('project-modal')">Annuler</button>
      <button id="pm-submit" type="submit" class="btn btn-primary">Créer le plan</button>
    </div>
  </form>
</div>

<!-- Enregistrer -->
<div id="save-modal" class="modal-backdrop" role="dialog" aria-modal="true">
  <div class="modal">
    <div class="modal-head">
      <div><h3 class="modal-title">Enregistrer</h3><p class="modal-sub">Votre plan est aussi sauvegardé automatiquement sur cet appareil.</p></div>
      <button class="modal-close" onclick="closeModal('save-modal')" aria-label="Fermer"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body stack-3">
      <button class="option-card" onclick="saveToApp()">
        <span class="oc-icon" style="background:var(--gold-50);color:var(--gold-600)"><i class="fa-solid fa-cloud-arrow-up"></i></span>
        <span><span class="oc-title">Sur l'application</span><span class="oc-sub" style="display:block">Pour reprendre votre plan plus tard</span></span>
        <i class="fa-solid fa-chevron-right oc-arrow"></i>
      </button>
      <button class="option-card" onclick="saveToComputer()">
        <span class="oc-icon" style="background:#E8EDF5;color:var(--ink-2)"><i class="fa-regular fa-file-pdf"></i></span>
        <span><span class="oc-title">Document PDF</span><span class="oc-sub" style="display:block">Plan de salle + liste des invités par table</span></span>
        <i class="fa-solid fa-chevron-right oc-arrow"></i>
      </button>
      <button class="option-card" onclick="exportBackup()">
        <span class="oc-icon" style="background:var(--success-bg);color:var(--success)"><i class="fa-solid fa-file-arrow-down"></i></span>
        <span><span class="oc-title">Fichier de sauvegarde</span><span class="oc-sub" style="display:block">Pour transférer le projet sur un autre appareil</span></span>
        <i class="fa-solid fa-chevron-right oc-arrow"></i>
      </button>
    </div>
  </div>
</div>

<!-- Générer un plan -->
<div id="generate-plan-modal" class="modal-backdrop" role="dialog" aria-modal="true">
  <form class="modal" novalidate onsubmit="event.preventDefault(); confirmGeneratePlan();">
    <div class="modal-head">
      <div><h3 id="gen-title" class="modal-title">Générer un plan</h3><p class="modal-sub">Une disposition complète, prête à recevoir vos invités.</p></div>
      <button type="button" class="modal-close" onclick="closeModal('generate-plan-modal')" aria-label="Fermer"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body stack-4">
      <div>
        <label class="label" for="gen-plan-type">Type de table</label>
        <select id="gen-plan-type" class="input" onchange="updateGenPlanDefaultDims()">
          <option value="table_rectangulaire">Table rectangulaire</option>
          <option value="table_ronde">Table ronde</option>
          <option value="table_haute">Table haute (mange-debout)</option>
        </select>
      </div>
      <div class="grid-2">
        <div><label class="label" for="gen-plan-width">Longueur (cm)</label><input type="number" id="gen-plan-width" min="40" class="input"></div>
        <div><label class="label" for="gen-plan-height">Largeur (cm)</label><input type="number" id="gen-plan-height" min="40" class="input"></div>
      </div>
      <p class="help" style="margin:0"><i class="fa-solid fa-circle-info" style="color:var(--gold)"></i> Ces dimensions s'appliquent à toutes les tables générées. Les éléments de décor sont conservés.</p>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" onclick="closeModal('generate-plan-modal')">Annuler</button>
      <button type="submit" class="btn btn-gold"><i class="fa-solid fa-wand-magic-sparkles"></i> Générer le plan</button>
    </div>
  </form>
</div>

<!-- Sélecteur d'éléments -->
<div id="element-picker-modal" class="modal-backdrop" role="dialog" aria-modal="true">
  <div class="modal modal-lg">
    <div class="modal-head">
      <div><h3 class="modal-title">Ajouter un élément</h3><p class="modal-sub">Tables, mobilier, animation, structure de la salle…</p></div>
      <button class="modal-close" onclick="closeModal('element-picker-modal')" aria-label="Fermer"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div style="padding:14px 24px 0">
      <div class="input-icon"><i class="fa-solid fa-magnifying-glass"></i><input id="picker-search" class="input" placeholder="Rechercher : table, bar, DJ, porte…" oninput="buildElementPicker()" autocomplete="off" data-autofocus></div>
    </div>
    <div id="element-picker-grid" class="modal-body"></div>
  </div>
</div>

<!-- Dimensions d'un nouvel élément -->
<div id="dimension-modal" class="modal-backdrop" role="dialog" aria-modal="true">
  <form class="modal modal-sm" novalidate onsubmit="event.preventDefault(); confirmAddCustomElement();">
    <div class="modal-head">
      <div><h3 id="dimension-modal-title" class="modal-title">Ajouter</h3><p class="modal-sub">Dimensions réelles, en centimètres.</p></div>
      <button type="button" class="modal-close" onclick="closeModal('dimension-modal')" aria-label="Fermer"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body stack-4">
      <div id="dim-row-wh" class="grid-2">
        <div><label class="label" id="dim-label-w" for="custom-dim-width">Longueur (cm)</label><input type="number" id="custom-dim-width" min="5" class="input" data-autofocus></div>
        <div><label class="label" id="dim-label-h" for="custom-dim-height">Largeur (cm)</label><input type="number" id="custom-dim-height" min="5" class="input"></div>
      </div>
      <div id="dim-row-diam"><label class="label" for="custom-dim-diam">Diamètre (cm)</label><input type="number" id="custom-dim-diam" min="40" class="input" data-autofocus></div>
      <div id="dim-row-seats"><label class="label" for="custom-dim-seats">Nombre de places</label><input type="number" id="custom-dim-seats" min="1" max="24" class="input"></div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" onclick="closeModal('dimension-modal')">Annuler</button>
      <button type="submit" class="btn btn-primary">Ajouter au plan</button>
    </div>
  </form>
</div>

<!-- Modifier un élément -->
<div id="edit-element-modal" class="modal-backdrop" role="dialog" aria-modal="true">
  <form class="modal modal-sm" novalidate onsubmit="event.preventDefault(); saveElementEdit();">
    <div class="modal-head">
      <div><h3 id="edit-elem-title" class="modal-title">Dimensions</h3><p class="modal-sub">Dimensions réelles, en centimètres.</p></div>
      <button type="button" class="modal-close" onclick="closeModal('edit-element-modal')" aria-label="Fermer"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body">
      <div class="grid-2">
        <div><label class="label" for="edit-elem-width">Longueur (cm)</label><input type="number" id="edit-elem-width" min="5" class="input" data-autofocus></div>
        <div><label class="label" for="edit-elem-height">Largeur (cm)</label><input type="number" id="edit-elem-height" min="5" class="input"></div>
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" onclick="closeModal('edit-element-modal')">Annuler</button>
      <button type="submit" class="btn btn-primary">Enregistrer</button>
    </div>
  </form>
</div>

<!-- Assigner une place -->
<div id="assign-modal" class="modal-backdrop" role="dialog" aria-modal="true">
  <div class="modal modal-md">
    <div class="modal-head">
      <div><h3 id="assign-title" class="modal-title">Place</h3><p class="modal-sub">Choisissez qui s'assoit à cette place.</p></div>
      <button class="modal-close" onclick="closeModal('assign-modal')" aria-label="Fermer"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body stack-3">
      <div id="assign-current"></div>
      <div class="assign-list-head" style="margin-top:6px">
        <span class="label" id="assign-list-title">Choisir un invité</span>
        <label class="check"><input type="checkbox" id="assign-show-placed" onchange="assignFilter.showPlaced=this.checked; renderAssignList()"> Inclure les invités déjà placés</label>
      </div>
      <div class="input-icon"><i class="fa-solid fa-magnifying-glass"></i><input id="modal-search" class="input input-sm" placeholder="Rechercher un invité…" oninput="assignFilter.search=this.value; renderAssignList()" autocomplete="off" data-autofocus></div>
      <div id="modal-filter-pills" class="pill-row"></div>
      <div id="modal-unassigned-list" class="assign-list"></div>
    </div>
  </div>
</div>

<!-- Configurer une table -->
<div id="config-table-modal" class="modal-backdrop" role="dialog" aria-modal="true">
  <form class="modal modal-md" novalidate onsubmit="event.preventDefault(); saveTableConfig();">
    <div class="modal-head">
      <div><h3 id="config-title" class="modal-title">Configurer la table</h3><p class="modal-sub">Les chaises sont réparties uniformément autour de la table.</p></div>
      <button type="button" class="modal-close" onclick="closeModal('config-table-modal')" aria-label="Fermer"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body stack-4">
      <div><label class="label" for="config-table-name">Nom de la table</label><input id="config-table-name" class="input" autocomplete="off" data-autofocus></div>
      <div id="config-row-wh" class="grid-2">
        <div><label class="label" for="config-table-width">Longueur (cm)</label><input type="number" id="config-table-width" min="50" class="input"></div>
        <div><label class="label" for="config-table-height">Largeur (cm)</label><input type="number" id="config-table-height" min="40" class="input"></div>
      </div>
      <div id="config-row-diam"><label class="label" for="config-table-diam">Diamètre (cm)</label><input type="number" id="config-table-diam" min="40" class="input"></div>
      <div>
        <div class="row between"><span class="label" style="margin:0">Places</span><span id="config-total-label" class="total-chip">0 place</span></div>
        <div id="config-seats-rect" class="seat-layout">
          <div style="grid-column:2;grid-row:1"><div class="stepper-label">Haut</div><div class="stepper"><button type="button" onclick="adjustConfigChair('top',-1)" aria-label="Retirer">−</button><span class="val" id="config-count-top">0</span><button type="button" onclick="adjustConfigChair('top',1)" aria-label="Ajouter">+</button></div></div>
          <div style="grid-column:1;grid-row:2"><div class="stepper-label">Gauche</div><div class="stepper"><button type="button" onclick="adjustConfigChair('left',-1)" aria-label="Retirer">−</button><span class="val" id="config-count-left">0</span><button type="button" onclick="adjustConfigChair('left',1)" aria-label="Ajouter">+</button></div></div>
          <div class="seat-table">Table</div>
