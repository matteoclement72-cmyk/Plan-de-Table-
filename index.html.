/* =========================================================
   UTILITAIRES
   ========================================================= */
const $ = (s) => document.querySelector(s);
const clone = (o) => JSON.parse(JSON.stringify(o));
const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
const wait = (ms) => new Promise(r => setTimeout(r, ms));
function esc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
function initials(name) {
  const parts = String(name).trim().split(/\s+/).filter(Boolean);
  if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
  return String(name).trim().substring(0, 2).toUpperCase();
}
function shortName(name) {
  const parts = String(name).trim().split(/\s+/).filter(Boolean);
  if (parts.length >= 2) return `${parts[0]} ${parts[1][0]}.`;
  return parts[0] || '';
}
function slug(s) { return String(s).normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/gi, '_').replace(/^_|_$/g, '').toLowerCase() || 'plan'; }
function formatDate(iso) { try { return new Date(iso + 'T00:00:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }); } catch (e) { return iso; } }
function getCurrentProject() { return projects.find(p => p.id === currentProjectId); }
function tablePx(t) { return { w: t.widthCm * SCALE_CM_TO_PX, h: t.heightCm * SCALE_CM_TO_PX }; }
function isRoundTable(t) { return !!(TABLE_TYPES[t.type] && TABLE_TYPES[t.type].isRound); }
function newChairId() { return 'c_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 7); }
function nextId(list) { return list.length ? Math.max(...list.map(x => +x.id || 0)) + 1 : 1; }
function sortedTables() { return [...tables].sort((a, b) => String(a.name).localeCompare(String(b.name), 'fr', { numeric: true })); }
function guestLocation(g) {
  const t = tables.find(x => x.id === g.tableId); if (!t) return '';
  const idx = t.chairList.findIndex(c => c.id === g.chairId);
  return `${t.name} · place ${idx + 1}`;
}
function downloadBlob(blob, filename) {
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = filename;
  document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 1500);
}

